rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function profile() { return get(userPath()).data; }
    function activeProfile() { return hasProfile() && profile().status == 'active'; }
    function belongsToSchool(schoolId) { return activeProfile() && profile().schoolId == schoolId; }
    function isTeacher(schoolId) { return belongsToSchool(schoolId) && profile().role in ['teacher', 'admin', 'owner']; }
    function isStudent(schoolId) { return belongsToSchool(schoolId) && profile().role == 'student'; }
    function isAdmin(schoolId) { return belongsToSchool(schoolId) && profile().role in ['admin', 'owner']; }
    function memberPath(classId) { return /databases/$(database)/documents/class_members/$(classId + '_' + request.auth.uid); }
    function isClassMember(classId) {
      return activeProfile() && exists(memberPath(classId))
        && get(memberPath(classId)).data.status == 'active';
    }
    function isClassTeacher(classId, schoolId) {
      return isTeacher(schoolId) && (
        isAdmin(schoolId)
        || (exists(/databases/$(database)/documents/class_members/$(classId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/class_members/$(classId + '_' + request.auth.uid)).data.role == 'teacher'
          && get(/databases/$(database)/documents/class_members/$(classId + '_' + request.auth.uid)).data.status == 'active')
      );
    }
    function attendanceSessionPath(sessionId) {
      return /databases/$(database)/documents/attendance_sessions/$(sessionId);
    }
    function ownsAttendanceSession(sessionId) {
      return exists(attendanceSessionPath(sessionId))
        && get(attendanceSessionPath(sessionId)).data.createdBy == request.auth.uid;
    }

    match /users/{uid} {
      // Students can read their own profile. Only school administrators can inspect all profiles.
      // Teachers receive the minimum roster snapshot in class_members instead.
      allow get: if signedIn() && request.auth.uid == uid || isAdmin(resource.data.schoolId);
      allow list: if isAdmin(resource.data.schoolId);
      allow create, delete: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo']);
    }

    match /settings/{settingId} {
      allow read: if belongsToSchool(resource.data.schoolId);
      allow create: if isAdmin(request.resource.data.schoolId)
        && request.resource.data.keys().hasOnly(['schoolId', 'logo', 'hue', 'ts']);
      allow update: if isAdmin(resource.data.schoolId)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logo', 'hue', 'ts']);
      allow delete: if isAdmin(resource.data.schoolId);
    }

    match /classes/{classId} {
      allow get, list: if belongsToSchool(resource.data.schoolId)
        && (isAdmin(resource.data.schoolId)
          || resource.data.teacherUid == request.auth.uid
          || isClassMember(classId));
      // Class creation, join codes, and membership changes are callable/server-only.
      allow create, update, delete: if false;
    }

    match /class_members/{memberId} {
      allow get, list: if belongsToSchool(resource.data.schoolId)
        && (resource.data.uid == request.auth.uid
          || isAdmin(resource.data.schoolId)
          || isClassTeacher(resource.data.classId, resource.data.schoolId));
      allow create, update, delete: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if belongsToSchool(resource.data.schoolId)
        && (!('classId' in resource.data)
          || isAdmin(resource.data.schoolId)
          || isClassMember(resource.data.classId)
          || isClassTeacher(resource.data.classId, resource.data.schoolId));
      // Legacy unscoped assignment compatibility only. New class assignments use callable API.
      allow create: if isTeacher(request.resource.data.schoolId)
        && !('classId' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.keys().hasOnly(['schoolId', 'createdBy', 'title', 'due', 'ts']);
      allow update: if isTeacher(resource.data.schoolId)
        && !('classId' in resource.data)
        && (resource.data.createdBy == request.auth.uid || isAdmin(resource.data.schoolId))
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'due', 'ts']);
      allow delete: if isTeacher(resource.data.schoolId)
        && (resource.data.createdBy == request.auth.uid || isAdmin(resource.data.schoolId));
    }

    match /submissions/{submissionId} {
      allow read: if belongsToSchool(resource.data.schoolId)
        && (resource.data.uid == request.auth.uid
          || isAdmin(resource.data.schoolId)
          || (('classId' in resource.data) && isClassTeacher(resource.data.classId, resource.data.schoolId)));
      // New class submissions and grading are callable/server-only.
      allow create: if isStudent(request.resource.data.schoolId)
        && !('classId' in request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentId == profile().studentId
        && request.resource.data.status == 'COMPLETED'
        && request.resource.data.score == null
        && submissionId == request.resource.data.assignmentId + '_' + profile().studentId
        && exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId))
        && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.schoolId == profile().schoolId
        && request.resource.data.keys().hasOnly(['schoolId', 'assignmentId', 'studentId', 'uid', 'status', 'score', 'ts']);
      allow update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if belongsToSchool(resource.data.schoolId)
        && (isAdmin(resource.data.schoolId) || isClassMember(resource.data.classId)
          || isClassTeacher(resource.data.classId, resource.data.schoolId));
      allow create, update, delete: if false;
    }

    match /attendance_sessions/{sessionId} {
      allow read: if belongsToSchool(resource.data.schoolId)
        && (isAdmin(resource.data.schoolId)
          || resource.data.createdBy == request.auth.uid
          || (('classId' in resource.data) && isClassTeacher(resource.data.classId, resource.data.schoolId)));
      allow write: if false;
    }
    match /attendance_logs/{recordId} {
      allow read: if (isStudent(resource.data.schoolId) && resource.data.uid == request.auth.uid)
        || (belongsToSchool(resource.data.schoolId)
          && (isAdmin(resource.data.schoolId)
            || ownsAttendanceSession(resource.data.sessionId)
            || (('classId' in resource.data) && isClassTeacher(resource.data.classId, resource.data.schoolId))));
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
